      "id": "en-tea-explicit-replacement",
      "language": "en",
      "kind": "replacement",
      "steps": [
        {
          "input": "I usually prefer green tea in the afternoon.",
          "expect": "establish"
        },
        {
          "input": "That has changed: I prefer black tea in the afternoon now.",
          "expect": "replace"
        }
      ],
      "followUp": "What tea would suit me this afternoon?",
      "requiredTerms": [
        "black tea"
      ],
      "forbiddenTerms": [
        "green tea"
      ]
    },
