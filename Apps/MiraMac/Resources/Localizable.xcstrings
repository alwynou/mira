    "The model capability probe candidate is invalid.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe candidate is invalid."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测使用的候选配置无效。"}}}},
    "The capability probe observation date is invalid.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The capability probe observation date is invalid."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测结果的日期无效。"}}}},
    "The model capability probe timeout is invalid.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe timeout is invalid."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测的超时设置无效。"}}}},
    "The model capability probe operation limit is invalid.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe operation limit is invalid."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测的操作数量限制无效。"}}}},
    "Model capability probing was stopped.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Model capability probing was stopped."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测已停止。"}}}},
    "Too many model capability probe operations are active.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Too many model capability probe operations are active."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在进行的模型能力探测操作过多。"}}}},
    "Too many unsaved model capability observations.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Too many unsaved model capability observations."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未保存的模型能力探测结果过多。"}}}},
    "The model capability observation was not produced by this service.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability observation was not produced by this service."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "该模型能力探测结果并非由当前服务生成。"}}}},
    "The model route changed while the capability probe was running.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model route changed while the capability probe was running."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测期间，模型路线已改变。"}}}},
    "A capability probe changed frozen route configuration.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A capability probe changed frozen route configuration."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测修改了已冻结的路线配置。"}}}},
    "A capability probe declared an unauthorized capability.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "A capability probe declared an unauthorized capability."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测声明了未经允许的能力。"}}}},
    "The model capability probe timed out.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe timed out."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测已超时。"}}}},
    "The capability probe authorization belongs to another library.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The capability probe authorization belongs to another library."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测授权属于另一个资料库。"}}}},
    "The capability probe authorization is stale.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The capability probe authorization is stale."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能力探测授权已失效。"}}}},
    "The configured model revision is exhausted.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The configured model revision is exhausted."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型配置修订号已达到上限。"}}}},
    "The model capability record is too large.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability record is too large."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力记录过大。"}}}},
    "The model capability revision changed during the probe save.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability revision changed during the probe save."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "保存探测结果时，模型能力修订已改变。"}}}},
    "The model capability probe could not be saved.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe could not be saved."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法保存模型能力探测结果。"}}}},
    "Some notifications for this library remain after retirement. Retry notification cleanup.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Some notifications for this library remain after retirement. Retry notification cleanup."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "该资料库仍有未清除的通知，请重试通知清理。"}}}},
    "Backup verified and restored to a separate library.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Backup verified and restored to a separate library."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "备份已验证并恢复到独立资料库。"}}}},
    "Unreferenced file cleanup completed.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unreferenced file cleanup completed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未引用文件清理已完成。"}}}},
    "Credential cleanup completed.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Credential cleanup completed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "凭据清理已完成。"}}}},
    "Restored library is now open.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Restored library is now open."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已打开恢复后的资料库。"}}}},
    "Open Restored Library": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open Restored Library"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开恢复后的资料库"}}}},
    "Cleanup removes unreferenced managed files after active library work has stopped. Referenced historical versions and existing backups are preserved.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cleanup removes unreferenced managed files after active library work has stopped. Referenced historical versions and existing backups are preserved."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "清理将在资料库中的活动工作停止后移除未引用的托管文件，保留仍被引用的历史版本和现有备份。"}}}},
    "Message body unavailable": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Message body unavailable"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "消息正文不可用"}}}},
    "The source session is still loading.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The source session is still loading."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源会话仍在加载。"}}}},
    "Checking source": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Checking source"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在检查来源"}}}},
    "The original message is unavailable until the library is ready.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original message is unavailable until the library is ready."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "资料库就绪后才能读取原始消息。"}}}},
    "The previous version remains in history.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The previous version remains in history."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "以前的版本仍保留在历史记录中。"}}}},
