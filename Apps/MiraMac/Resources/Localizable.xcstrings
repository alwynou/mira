          }
        }
      }
    },
    "Choose a model from your pool for each purpose and scope. Background extraction requires its own explicit selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model from your pool for each purpose and scope. Background extraction requires its own explicit selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个用途和范围从模型池选择模型。后台记忆提取需要单独明确选择。"
          }
        }
      }
    },
