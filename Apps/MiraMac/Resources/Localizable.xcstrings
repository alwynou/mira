    "The active session draft exceeds its supported bounds.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The active session draft exceeds its supported bounds."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前会话草稿超出支持的范围。"}}}},
    "The active model block is invalid or exceeds its bounds.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The active model block is invalid or exceeds its bounds."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前模型内容块无效或超出限制。"}}}},
