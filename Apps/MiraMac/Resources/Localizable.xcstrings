      }
    },
    "A competing replacement is awaiting review. Reject it or review the current successor before approving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A competing replacement is awaiting review. Reject it or review the current successor before approving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竞争性的替代记忆正在等待审核。请先拒绝它，或查看当前后继记忆，再进行批准。"
          }
        }
      }
    },
    "A dispatched tool call cannot be marked as cancelled before dispatch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dispatched tool call cannot be marked as cancelled before dispatch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已调度的工具调用不能标记为未调度取消。"
          }
        }
      }
    },
    "A forgotten memory cannot be recreated by reusing an operation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgotten memory cannot be recreated by reusing an operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已遗忘的记忆不能通过重复使用操作重新创建。"
          }
        }
      }
    },
    "A forgotten memory cannot be revised.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgotten memory cannot be revised."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已遗忘的记忆不能修订。"
          }
        }
      }
    },
    "A forgotten memory cannot change state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgotten memory cannot change state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已遗忘的记忆不能更改状态。"
          }
        }
      }
    },
    "A memory refers to a missing workspace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A memory refers to a missing workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆引用了不存在的工作空间。"
          }
        }
      }
    },
    "A memory with an unresolved replacement cannot be approved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A memory with an unresolved replacement cannot be approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未解决替代项的记忆不能批准。"
          }
        }
      }
    },
    "A model descriptor selects a connection and records declared or probed capabilities.": {
      "localizations": {
