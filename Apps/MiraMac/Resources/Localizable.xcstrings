    "The local embedding model is not prepared.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The local embedding model is not prepared."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本地向量模型尚未就绪。"}}}},
    "A document embedding dispatch supports one to four documents.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A document embedding dispatch supports one to four documents."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "一次向量处理支持 1 至 4 段文本。"}}}},
    "Embedding input cannot be empty.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Embedding input cannot be empty."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "向量处理的输入不能为空。"}}}},
    "Local embedding inference failed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Local embedding inference failed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本地向量推理失败。"}}}},
