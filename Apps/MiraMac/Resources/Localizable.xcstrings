    "A tool-disabled cached prefix must be followed by exactly one user message.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A tool-disabled cached prefix must be followed by exactly one user message."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "禁用工具的缓存前缀后必须紧跟一条用户消息。"}}}},
    "The model output limit exceeds the frozen route budget.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model output limit exceeds the frozen route budget."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型输出上限超过了冻结路由预算。"}}}},
    "The requested model output limit must be positive.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The requested model output limit must be positive."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请求的模型输出上限必须为正数。"}}}},
