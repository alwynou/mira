            "value": "Add to Pool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入模型池"
          }
        }
      }
    },
    "Adding a model to the pool does not select it for any purpose. Removing a local selection uses the workspace or global default when configured.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding a model to the pool does not select it for any purpose. Removing a local selection uses the workspace or global default when configured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入模型池不会自动为任何用途选用该模型。移除当前范围的选择后，将使用已配置的工作空间或全局默认模型。"
          }
        }
      }
    },
    "Anthropic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic"
          }
        }
      }
    },
    "Capability tests send a fixed synthetic prompt without conversation history. Your provider may charge for the request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capability tests send a fixed synthetic prompt without conversation history. Your provider may charge for the request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能力测试仅发送固定的合成提示词，不包含对话历史。服务商可能对此请求收费。"
          }
        }
      }
    },
    "Choose Default Models": {
      "localizations": {
