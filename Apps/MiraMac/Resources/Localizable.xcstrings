    "Backups contain conversations, configuration, request records, knowledge source versions and files, plus integrity checksums. API keys and other credentials are excluded. Restoring creates a separate directory and preserves the current library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups contain conversations, configuration, request records, knowledge source versions and files, plus integrity checksums. API keys and other credentials are excluded. Restoring creates a separate directory and preserves the current library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含对话、配置、请求记录、知识来源版本和文件，以及完整性校验和。备份不包含 API 密钥或其他凭据。恢复会创建单独的目录，并保留当前库。"
          }
        }
      }
    },
    "Unreferenced managed files are eligible for cleanup after 7 days. Cleanup never removes referenced historical versions and does not rewrite existing backups.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreferenced managed files are eligible for cleanup after 7 days. Cleanup never removes referenced historical versions and does not rewrite existing backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未被引用的托管文件可在 7 天后清理。清理不会删除仍被引用的历史版本，也不会改写现有备份。"
          }
        }
      }
    },
    "Clean Up Unreferenced Files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean Up Unreferenced Files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理未被引用的文件"
          }
        }
      }
    },
    "Cleaned up %lld unreferenced files; retained %lld referenced files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaned up %lld unreferenced files; retained %lld referenced files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %lld 个未被引用的文件；保留 %lld 个被引用的文件。"
          }
        }
      }
    },
    "This permanently removes %@, its versions and chunks, and derived source bodies. Historical body-free usage records remain. Unreferenced managed file copies may remain for at least 7 days before cleanup; existing backups are not rewritten, and the original external file is never modified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes %@, its versions and chunks, and derived source bodies. Historical body-free usage records remain. Unreferenced managed file copies may remain for at least 7 days before cleanup; existing backups are not rewritten, and the original external file is never modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会永久移除 %@、其版本和分块，以及派生的来源正文。历史无正文使用记录会保留。未被引用的托管文件副本可能至少保留 7 天后才清理；现有备份不会改写，原始外部文件也不会被修改。"
          }
        }
      }
    },
