    "The embedding model returned an invalid vector.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The embedding model returned an invalid vector."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "向量模型返回了无效向量。"}}}},
