    "The model continuation belongs to a different adapter.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model continuation belongs to a different adapter."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型续接数据属于其他适配器。"}}}},
