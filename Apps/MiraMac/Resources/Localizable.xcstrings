    "Activate a provider and enable its models. Disabled providers keep their selections but are hidden from this pool.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate a provider and enable its models. Disabled providers keep their selections but are hidden from this pool."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活服务商并启用其模型。停用服务商会保留模型选择，但会将其从模型池中隐藏。"
          }
        }
      }
    },
    "Activate the current provider configuration before fetching models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate the current provider configuration before fetching models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先激活当前服务商配置，再获取模型列表。"
          }
        }
      }
    },
    "Activate this provider to fetch or add models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate this provider to fetch or add models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活此服务商后即可获取或添加模型。"
          }
        }
      }
    },
    "Activation allows explicit model requests. It does not verify connectivity or enable any models automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation allows explicit model requests. It does not verify connectivity or enable any models automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活后可主动发起模型请求。激活本身不会验证连接，也不会自动启用任何模型。"
          }
        }
      }
    },
