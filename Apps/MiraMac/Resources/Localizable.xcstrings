    "The public model metadata source could not be refreshed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The public model metadata source could not be refreshed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法刷新公开模型元数据来源。"}}}},
