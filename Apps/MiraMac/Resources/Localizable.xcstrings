    "Library executions did not settle before switching.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Library executions did not settle before switching."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "切换前，资料库中的执行尚未完成结算。"}}}},
