    "Custom Provider": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom Provider"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义服务商"
          }
        }
      }
    },
    "Declare capabilities only when you have verified them. Capability observations reset when the connection, model ID, or context window changes. Adding a model does not verify its capabilities. Use Test Text and Test Tools from the model pool.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare capabilities only when you have verified them. Capability observations reset when the connection, model ID, or context window changes. Adding a model does not verify its capabilities. Use Test Text and Test Tools from the model pool."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅声明你已确认的能力。连接、模型 ID 或上下文窗口变化后，能力测试记录会重置。添加模型不会验证其能力；可在模型池中执行文本和工具测试。"
          }
        }
      }
    },
    "Default Models": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认模型"
          }
        }
      }
    },
