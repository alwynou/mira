          "stringUnit": {
            "state": "translated",
            "value": "获取模型列表或手工添加模型 ID，然后配置要使用的模型。"
          }
        }
      }
    },
    "Fetching reads only this provider’s model catalog. You can add a private deployment ID manually if discovery is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetching reads only this provider’s model catalog. You can add a private deployment ID manually if discovery is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取操作仅查询此服务商的模型目录。如果无法发现模型，可以手工添加私有部署 ID。"
          }
        }
      }
    },
