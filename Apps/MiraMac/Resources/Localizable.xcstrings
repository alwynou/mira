    "The model metadata refresh was cancelled.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model metadata refresh was cancelled."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型元数据刷新已取消。"}}}},
    "The public model metadata response is invalid or incomplete.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The public model metadata response is invalid or incomplete."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "公开模型元数据响应无效或不完整。"}}}},
