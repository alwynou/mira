    "Source": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源"}}}},
    "Source unavailable": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Source unavailable"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源不可用"}}}},
    "Stored on this device": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Stored on this device"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "保存在此设备上"}}}},
    "Removed": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Removed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已移除"}}}},
    "The content and source excerpts have been cleared. This record prevents the same memory from being learned again.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The content and source excerpts have been cleared. This record prevents the same memory from being learned again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "内容和来源摘录已清除。此记录会防止系统再次学到同一条记忆。"}}}},
    "The memory source is unavailable.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The memory source is unavailable."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆来源不可用。"}}}},
    "The new memory becomes current. The previous memory stays in history.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The new memory becomes current. The previous memory stays in history."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "新记忆将成为当前记忆。先前的记忆会保留在历史记录中。"}}}},
    "The conversation changed while opening its memory source.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The conversation changed while opening its memory source."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开记忆来源时，对话内容已发生变化。"}}}},
    "The conversation library is not ready.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The conversation library is not ready."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "对话资料库尚未就绪。"}}}},
    "The conversation library changed while opening its source.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The conversation library changed while opening its source."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开来源时，对话资料库已发生变化。"}}}},
    "The conversation source history could not be paged safely.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The conversation source history could not be paged safely."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法安全分页读取对话来源历史记录。"}}}},
    "The original user message is unavailable.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original user message is unavailable."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原始用户消息不可用。"}}}},
    "The source workspace is no longer available.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The source workspace is no longer available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "来源工作区已不可用。"}}}},
    "This source is too far back to open in the conversation. Open the original conversation and load earlier messages.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This source is too far back to open in the conversation. Open the original conversation and load earlier messages."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此来源位于对话较早位置，暂时无法打开。请打开原始对话并加载更早的消息。"}}}},
    "The scope and subject of an existing memory stay unchanged.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The scope and subject of an existing memory stay unchanged."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "现有记忆的范围和主体保持不变。"}}}},
    "This pending memory will become current. The current memory will remain in history.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This pending memory will become current. The current memory will remain in history."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这条待处理记忆将成为当前记忆。当前记忆会保留在历史记录中。"}}}},
    "This permanently clears the memory, its source excerpts, and derived data. A record remains to prevent it from being learned again. The original conversation stays on this device. This cannot be undone.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This permanently clears the memory, its source excerpts, and derived data. A record remains to prevent it from being learned again. The original conversation stays on this device. This cannot be undone."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这会永久清除记忆、来源摘录和衍生数据。系统会保留一条记录，以防再次学到此记忆。原始对话仍保留在此设备上。此操作无法撤销。"}}}},
    "This permission is separate from scope and source access.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This permission is separate from scope and source access."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此权限与范围和来源访问权限相互独立。"}}}},
    "Try another search or scope.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Try another search or scope."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请尝试其他搜索词或范围。"}}}},
    "View original message": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "View original message"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看原始消息"}}}}
  },
  "version": "1.0"
}
