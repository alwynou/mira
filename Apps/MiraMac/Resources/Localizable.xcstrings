    "The model capability probe preparation capabilities are invalid.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The model capability probe preparation capabilities are invalid."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "模型能力探测所需的临时能力声明无效。"}}}},
