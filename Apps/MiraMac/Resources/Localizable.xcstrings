    "Anthropic manual thinking requires an output budget larger than its default thinking budget.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Anthropic manual thinking requires an output budget larger than its default thinking budget."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Anthropic 手动思考要求输出预算大于默认思考预算。"}}}},
