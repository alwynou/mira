    "Automatic": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatic"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动"}}}},
    "Embedding model": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Embedding model"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "向量模型"}}}},
    "Local memory search": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Local memory search"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本地记忆搜索"}}}},
    "Memories are indexed on this Mac. No embedding API key is needed.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Memories are indexed on this Mac. No embedding API key is needed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "记忆在这台 Mac 上建立索引，无需向量模型 API 密钥。"}}}},
    "Mira saves useful memories in the background after several turns or a pause, without asking each time.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mira saves useful memories in the background after several turns or a pause, without asking each time."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Mira 会在几轮对话或暂停后，在后台保存有用的记忆，无需逐条确认。"}}}},
    "Only memories you ask Mira to save are stored.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only memories you ask Mira to save are stored."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只保存你要求 Mira 记住的信息。"}}}},
