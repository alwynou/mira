    "Automatic memory output must use version 3 and only its required top-level keys.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatic memory output must use version 3 and only its required top-level keys."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动记忆输出必须使用版本 3，且只能包含要求的顶层字段。"}}}},
