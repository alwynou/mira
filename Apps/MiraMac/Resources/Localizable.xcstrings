    "Chat Completions": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chat Completions"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Chat Completions"}}}, "comment": "Protocol name; preserve the API name in both languages."},
    "Model Two": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Model Two"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "Model Two"}}}, "comment": "Synthetic model name in the component gallery; preserve model identity in both languages."},
