    "A route is a reusable preset. Assign it to a purpose and scope explicitly in Purpose Routing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A route is a reusable preset. Assign it to a purpose and scope explicitly in Purpose Routing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由是可复用的预设。请在“用途路由”中明确分配用途和范围。"
          }
        }
      }
    },
    "A route is never created automatically. Removing a local binding lets resolution continue to the workspace or global binding when one exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A route is never created automatically. Removing a local binding lets resolution continue to the workspace or global binding when one exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统不会自动创建路由。移除本地绑定后，如果工作区或全局绑定存在，解析会继续使用它。"
          }
        }
      }
    },
