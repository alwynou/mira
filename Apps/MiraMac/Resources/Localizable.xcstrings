    "The runtime contains duplicate capability probes.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The runtime contains duplicate capability probes."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "运行时包含重复的能力探测。"}}}},
