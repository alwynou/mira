    "Automatic memory item content is required and must be at most 8 KiB.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatic memory item content is required and must be at most 8 KiB."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动记忆内容不能为空，且不能超过 8 KiB。"}}}},
