    "The requested output limit must exceed the Anthropic thinking budget.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The requested output limit must exceed the Anthropic thinking budget."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请求的输出上限必须大于 Anthropic 思考预算。"}}}},
