    "The execution draft exceeds the read limit.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The execution draft exceeds the read limit."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "执行草稿超出读取限制。"}}}},
    "The active draft owner is no longer authorized.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The active draft owner is no longer authorized."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前草稿所属执行已失去授权。"}}}},
